# Copy to .env.local (gitignored) for `npm run dev`. Vercel holds the real values.
# Hosted project: Supabase dashboard → Project Settings → API.
# Local stack: run `supabase status` and use the API URL and anon key it prints.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — Sentry error tracking (no-op when empty)
VITE_SENTRY_DSN=
